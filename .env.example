# Copy to .env and fill in. .env is gitignored on purpose.
WP_BASE_URL=http://your-site.local

# Generate in wp-admin: Users > Profile > Application Passwords > Add New.
# WordPress shows the password exactly once, in xxxx xxxx xxxx xxxx xxxx xxxx form.
# Spaces are cosmetic; they may be kept or stripped when sending.
WP_ADMIN_USER=admin
WP_ADMIN_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

WP_EDITOR_USER=editor.example
WP_EDITOR_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
